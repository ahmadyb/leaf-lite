<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup / device transfer rules. -->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="database"
            path="documents.db" />
        <include
            domain="sharedpref"
            path="leaflite.xml" />
        <exclude
            domain="file"
            path="shared" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="database"
            path="documents.db" />
        <include
            domain="sharedpref"
            path="leaflite.xml" />
        <exclude
            domain="file"
            path="shared" />
    </device-transfer>
</data-extraction-rules>

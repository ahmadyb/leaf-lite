<?xml version="1.0" encoding="utf-8"?>
<!-- Bordered 38dp icon button: card background, 13dp corners, ripple above. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <stroke
                android:width="1dp"
                android:color="@color/line" />
            <corners android:radius="@dimen/radius_icon_btn" />
        </shape>
    </item>
</ripple>

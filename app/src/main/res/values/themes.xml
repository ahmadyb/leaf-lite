<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Leaf Lite runs edge-to-edge on every supported API: the status bar and
      navigation bar are transparent and the screens consume the insets
      themselves (see util/InsetsExt.kt).
    -->
    <style name="Theme.LeafLite" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="bottomSheetDialogTheme">@style/Theme.LeafLite.BottomSheetDialog</item>
        <item name="android:alertDialogTheme">@style/Theme.LeafLite.Dialog</item>
    </style>

    <style name="Theme.LeafLite.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">85%</item>
    </style>

    <style name="Theme.LeafLite.BottomSheetDialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <!-- typography: every text style used by the app -->

    <style name="TextAppearance.Leaf" parent="TextAppearance.AppCompat" />

    <style name="TextAppearance.Leaf.Brand">
        <item name="android:textSize">23sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="TextAppearance.Leaf.BrandMuted">
        <item name="android:textSize">23sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="TextAppearance.Leaf.FileName">
        <item name="android:textSize">14.5sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextAppearance.Leaf.FileSub">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/faint</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextAppearance.Leaf.SectionHeader">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/faint</item>
    </style>

    <style name="TextAppearance.Leaf.Chip">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/chip_text</item>
    </style>

    <style name="TextAppearance.Leaf.TabLabel">
        <item name="android:textSize">10.5sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Leaf.Search">
        <item name="android:textSize">14.5sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/faint</item>
    </style>

    <!-- reading bodies -->
    <style name="TextAppearance.Leaf.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/body_text</item>
        <item name="android:lineSpacingExtra">9sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Leaf.Heading1">
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Leaf.Heading2">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Leaf.TagPill">
        <item name="android:textSize">10.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="TextAppearance.Leaf.Code">
        <item name="android:textSize">12.5sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/body_text</item>
        <item name="android:lineSpacingExtra">3sp</item>
    </style>

    <style name="TextAppearance.Leaf.Cell">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/body_text</item>
    </style>

    <style name="TextAppearance.Leaf.CellHeader">
        <item name="android:textSize">10.5sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/chip_text</item>
    </style>

    <!-- Naming base for Leaf.* styles. Declared explicitly because AAPT
         resolves the implicit dot-parent chain and fails the link when the
         root is absent. Intentionally empty. -->
    <style name="Leaf" />

    <!-- shared 48dp selectable row used by the sort sheet -->
    <style name="Leaf.SortRow">
        <item name="android:background">@drawable/ripple_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="TextAppearance.Leaf.Empty">
        <item name="android:textSize">13.5sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/faint</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="30dp"
    android:paddingTop="60dp"
    android:paddingEnd="30dp"
    android:paddingBottom="30dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/emptyIcon"
        android:layout_width="@dimen/empty_icon"
        android:layout_height="@dimen/empty_icon"
        android:alpha="0.5"
        app:srcCompat="@drawable/ic_type_text"
        app:tint="@color/faint" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/emptyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/empty_list"
        android:textAppearance="@style/TextAppearance.Leaf.Empty" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/emptyAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_accent"
        android:minHeight="44dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/open_elsewhere"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>

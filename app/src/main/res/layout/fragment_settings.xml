<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <View
        android:id="@+id/topInset"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <include
        android:id="@+id/header"
        layout="@layout/view_brand_header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- library profile card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/pad_screen"
                android:layout_marginEnd="@dimen/pad_screen"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:background="@drawable/bg_avatar">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        app:srcCompat="@drawable/ic_type_doc"
                        app:tint="@android:color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_library_title"
                        android:textAppearance="@style/TextAppearance.Leaf.FileName"
                        android:textSize="15sp" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/librarySub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_library_sub_never"
                        android:textAppearance="@style/TextAppearance.Leaf.FileSub"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/pad_header"
                android:paddingEnd="@dimen/pad_header"
                android:paddingBottom="10dp"
                android:text="@string/section_viewing"
                android:textAppearance="@style/TextAppearance.Leaf.SectionHeader" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/pad_screen"
                android:layout_marginEnd="@dimen/pad_screen"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:showDividers="middle">

                <com.leaflite.viewer.ui.widgets.SwitchRow
                    android:id="@+id/nightRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:subLabel="@string/s_night_sub"
                    app:label="@string/s_night" />

                <com.leaflite.viewer.ui.widgets.SwitchRow
                    android:id="@+id/keepScreenRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:subLabel="@string/s_screen_sub"
                    app:label="@string/s_screen" />

                <com.leaflite.viewer.ui.widgets.SwitchRow
                    android:id="@+id/compactRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:subLabel="@string/s_compact_sub"
                    app:label="@string/s_compact" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/pad_header"
                android:paddingTop="22dp"
                android:paddingEnd="@dimen/pad_header"
                android:paddingBottom="10dp"
                android:text="@string/section_about"
                android:textAppearance="@style/TextAppearance.Leaf.SectionHeader" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/pad_screen"
                android:layout_marginEnd="@dimen/pad_screen"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:showDividers="middle">

                <LinearLayout
                    android:id="@+id/versionRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ripple_row"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/s_version"
                            android:textAppearance="@style/TextAppearance.Leaf.FileName" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/versionSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.Leaf.FileSub" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        app:srcCompat="@drawable/ic_chevron_right"
                        app:tint="@color/chevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/formatsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ripple_row"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/s_formats"
                            android:textAppearance="@style/TextAppearance.Leaf.FileName" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/s_formats_sub"
                            android:textAppearance="@style/TextAppearance.Leaf.FileSub" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        app:srcCompat="@drawable/ic_chevron_right"
                        app:tint="@color/chevron" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

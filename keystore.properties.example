# Copy this file to ./keystore.properties (git-ignored) and fill in your own
# values to produce a signed release build:
#
#   cp keystore.properties.example keystore.properties
#
# If keystore.properties is absent, the release build type falls back to the
# debug signing config so `./gradlew assembleRelease` works out of the box.
storeFile=../leaf-lite.jks
storePassword=changeit
keyAlias=leaflite
keyPassword=changeit
